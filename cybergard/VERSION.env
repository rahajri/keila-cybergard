# ============================================================================
# Image Keila Cybergard — source de vérité unique (lu par build.sh et la CI)
# ============================================================================
# Toute modification de ce fichier (ou du branding) = nouvelle image :
#   - nouvelle version Keila        → KEILA_VERSION/KEILA_GIT_REF/KEILA_COMMIT
#   - changement de branding/build  → CYBERGARD_REVISION + 1
# Un tag publié n'est JAMAIS réécrit (la CI refuse de republier un tag existant).

# Dépôt officiel (AGPL-3.0) et version épinglée par tag ET par commit
KEILA_REPO=https://github.com/pentacent/keila.git
KEILA_VERSION=0.30.3
KEILA_GIT_REF=v0.30.3
KEILA_COMMIT=bccb0a8e612a6faacf9bc7180e5aa9126042cd6c

# Révision du branding Cybergard appliqué sur cette version
CYBERGARD_REVISION=1

# Image produite : ghcr.io/rahajri/keila:<KEILA_VERSION>-cybergard.<CYBERGARD_REVISION>
IMAGE_REPO=ghcr.io/rahajri/keila

# Source correspondant publié (obligation AGPL-3.0 §13) : dépôt public contenant
# le source Keila complet tel que construit, tagué v<version>-cybergard.<rev>.
# Le lien « Source code » intégré à l'interface pointe sur ce tag exact.
SOURCE_REPO=https://github.com/rahajri/keila-cybergard
SOURCE_TAG=v${KEILA_VERSION}-cybergard.${CYBERGARD_REVISION}
SOURCE_URL=${SOURCE_REPO}/tree/${SOURCE_TAG}

# Image Elixir/OTP épinglée par digest, utilisée pour le build ET le runtime
# (l'upstream mélange elixir:1.18-alpine — aujourd'hui OTP 28 — et OTP 27 au runtime)
ELIXIR_IMAGE=elixir:1.18.4-otp-27-alpine@sha256:7b0b369edb2f780f3776cfae85fb60f97d6f7c4aada7a1345ec1f0d1d041cb2c
